# ============================================================
# QMReader 配置示例 — 复制为 .env 后按需填写
#   cp .env.example .env
# 所有密钥/Cookie 均留空即可启动；对应功能在配置后自动生效。
# ============================================================

# ---------- 服务 ----------
# 默认环回，避免无鉴权服务暴露到局域网；公网/容器再显式设 0.0.0.0 并由反代暴露
HOST=127.0.0.1
PORT=8080

# ---------- AI（翻译 / 改写 / 侧边 AI 伴读）----------
# 二选一或都配：优先 DeepSeek，缺省回退 Gemini；都不配则 AI 功能不可用（阅读不受影响）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Google AI Studio Gemini（英文文章一键译简中）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# 自定义 OpenAI 兼容服务（可选）
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ---------- 刷新调度 ----------
STARTUP_REFRESH_DELAY_MS=30000
FRESHNESS_SWEEP_INTERVAL_MS=300000
FRESHNESS_STARTUP_DELAY_MS=120000
FRESHNESS_SWEEP_BATCH_SIZE=3
FRESHNESS_SWEEP_MAX_COST=6
FETCH_SOURCE_CONCURRENCY=6
TITLE_TRANSLATION_LIMIT=80

# ============================================================
# 个人内容源接入（按需配置；不配置则对应源保持为空，不影响其他功能）
# ============================================================

# ---------- B站（bili-watchlater：稍后再看 + 收藏夹同步）----------
# 方式 A（推荐）：直接粘贴 Cookie 字符串。
#   浏览器登录 bilibili.com → F12 开发者工具 → Network 任意请求 →
#   Request Headers 里复制 Cookie 中的 SESSDATA 等字段，形如：
#   BILI_COOKIE=SESSDATA=xxx; bili_jct=xxx; DedeUserID=xxx
BILI_COOKIE=
# 方式 B：指向本机 Zen/Firefox 系浏览器 profile 目录，自动读取已登录 Cookie
#   例：BILI_ZEN_PROFILE=/Users/<你>/Library/Application Support/zen/Profiles/<profile 目录>
BILI_ZEN_PROFILE=
# BILI_POLL_MS=300000
# BILI_SYNC_ENABLED=1

# ---------- 知乎（zhihu-*：博主专栏定时爬取导入）----------
# Cookie 从本机 Zen/Firefox 系浏览器 profile 离线读取（需已在浏览器登录知乎）：
#   例：ZHIHU_ZEN_PROFILE=/Users/<你>/Library/Application Support/zen/Profiles/<profile 目录>
# 关注的博主名单在 tools/blog_crawler/zhihu_playwright_export.py 的 PROFILES 中自行修改
ZHIHU_ZEN_PROFILE=
# ZHIHU_CRAWL_ENABLED=1
# ZHIHU_EXPORT_PATH=
# ZHIHU_IMPORT_STAMP=
# ZHIHU_REPAIR=1
# 知乎 localOnly：外部 crawl 写 stamp 后 Reader 轮询重读 DB（ms；0=关闭）
ZHIHU_RELOAD_POLL_MS=300000

# ---------- X / Twitter 收藏（x-likes：本地 Markdown 目录扫描）----------
# 本源不直接抓 X 接口，而是监听本地目录（由你的导出工具写入 Markdown）。
# 指向存放 X 收藏导出的目录即可，新文件会自动入库：
X_LIKES_DIR=
# 例：X_LIKES_DIR=/Users/<你>/Documents/X_Likes

# ---------- 小红书收藏（xhs-likes：本地 Markdown 目录扫描）----------
XHS_LIKES_DIR=
# 例：XHS_LIKES_DIR=/Users/<你>/Documents/XHS_Likes

# ---------- 小红书博主知识库（xhs-*：本地知识库目录）----------
# 目录下按博主名分子文件夹存放 Markdown；博主源定义在 lib/xhs-kb-sync.js 的 KB_SOURCES
XHS_KB_DIR=
# 例：XHS_KB_DIR=/Users/<你>/知识库/小红书

# ---------- GitHub（可选：提高仓库卡片 API 限额）----------
GITHUB_TOKEN=

# ---------- 统计（可选）----------
UMAMI_WEBSITE_ID=
UMAMI_SRC=
